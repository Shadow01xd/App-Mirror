[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%TYU%
DriverVer=09/17/2026,1.0.0.0
CatalogFile=TyuMicrophone.cat
PnpLockdown=1

[Manufacturer]
%TYU%=Models,NTamd64.10.0...19041
[Models.NTamd64.10.0...19041]
%Device%=Install,Root\TYUMicrophone
[SourceDisksNames]
1=%Disk%
[SourceDisksFiles]
TyuMicrophone.sys=1
[DestinationDirs]
CopyDriver=13
[CopyDriver]
TyuMicrophone.sys

[Install.NT]
CopyFiles=CopyDriver
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
AddReg=DeviceReg
[DeviceReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,TyuMicrophone.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%Device%
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Description,,%Device%
[Install.NT.Services]
AddService=TyuMicrophone,0x00000002,Service
[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\TyuMicrophone.sys
[Install.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,Wave,WaveInterface
AddInterface=%KSCATEGORY_CAPTURE%,Wave,WaveInterface
AddInterface=%KSCATEGORY_REALTIME%,Wave,WaveInterface
AddInterface=%KSCATEGORY_AUDIO%,Topology,TopologyInterface
AddInterface=%KSCATEGORY_TOPOLOGY%,Topology,TopologyInterface
[WaveInterface]
AddReg=WaveReg
[WaveReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Device%
[TopologyInterface]
AddReg=TopologyReg
[TopologyReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Device%
HKR,EP\0,%Association%,,%Microphone%
HKR,EP\0,%EventDriven%,0x00010001,1

