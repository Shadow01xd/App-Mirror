import { Colors } from "../theme/colors.slint";
import { Typography } from "../theme/typography.slint";
import { Spacing } from "../theme/spacing.slint";

export component SetupLayout inherits Rectangle {
    in property <string> title;
    in property <string> description;

    background: Colors.background;

    VerticalLayout {
        padding: Spacing.xxl;
        spacing: Spacing.md;
        alignment: start;

        Text {
            text: root.title;
            color: Colors.text-primary;
            font-family: Typography.ui-family;
            font-size: Typography.display-size;
            font-weight: 700;
        }
        Text {
            text: root.description;
            color: Colors.text-secondary;
            font-family: Typography.ui-family;
            font-size: Typography.body-size;
            wrap: word-wrap;
        }
    }
}

