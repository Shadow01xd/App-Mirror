export global Colors {
    out property <color> background: #000000;
    out property <color> surface: #151515;
    out property <color> surface-muted: #242424;
    out property <color> stage: #101010;
    out property <color> text-primary: #f5f5f2;
    out property <color> text-secondary: #b0b0aa;
    out property <color> muted: #858580;
    out property <color> border: #333333;
    out property <color> accent: #f6cc45;
    out property <color> accent-foreground: #171304;
    out property <color> primary-surface: #272313;
    out property <color> success: #43d17a;
    out property <color> warning: #f6cc45;
    out property <color> danger: #f26b6c;
    out property <color> disabled: #555550;
}
