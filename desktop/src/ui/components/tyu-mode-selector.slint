import { Colors } from "../theme/colors.slint";
import { TyuButton } from "tyu-button.slint";
export component TyuModeSelector inherits Rectangle {
    in property <int> selected-index;
    callback selected(int);
    height: 56px;
    min-width: 480px;
    background: transparent;
    // Explicit positions keep the three controls equal without inherited layout caps.
    for item[i] in [
        {label: "Monitor", icon: @image-url("../../../assets/icons/desktop.svg")},
        {label: "Espejo", icon: @image-url("../../../assets/icons/phone.svg")},
        {label: "Bypass", icon: @image-url("../../../assets/icons/swap.svg")}
    ]: TyuButton {
        x: i * (root.width + 12px) / 3;
        width: (root.width - 24px) / 3;
        height: 52px;
        label: item.label; icon: item.icon; has-icon: true; icon-size: 24px;
        secondary: root.selected-index != i;
        clicked => { root.selected(i); }
    }
}
