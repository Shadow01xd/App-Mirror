import { Colors } from "../theme/colors.slint";
import { Typography } from "../theme/typography.slint";
import { Spacing } from "../theme/spacing.slint";
import { Shapes } from "../theme/shapes.slint";

export component TyuDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;

    min-width: 360px;
    min-height: 180px;
    background: Colors.surface;
    border-width: Shapes.border-width;
    border-color: Colors.border;
    border-radius: Shapes.modal-radius;

    VerticalLayout {
        padding: Spacing.xl;
        spacing: Spacing.md;

        Text {
            text: root.title;
            color: Colors.text-primary;
            font-family: Typography.ui-family;
            font-size: Typography.heading-size;
            font-weight: 600;
        }
        Text {
            text: root.body;
            color: Colors.text-secondary;
            font-family: Typography.ui-family;
            font-size: Typography.body-size;
            wrap: word-wrap;
        }
    }
}

