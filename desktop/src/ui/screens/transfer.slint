import { Colors } from "../theme/colors.slint";
import { Data } from "../data.slint";
import { TyuButton } from "../components/tyu-button.slint";
import { TyuProgress } from "../components/tyu-progress.slint";

export component TransferScreen inherits Rectangle {
    background: transparent;
    VerticalLayout { alignment: start; spacing: 20px;
        Text { text: "Transferencias"; font-size: 28px; font-weight: 600; color: Colors.text-primary; }
        Text { text: "Entre este equipo y " + Data.device-name + " · por tu red local, sin Internet"; font-size: 13px; color: Colors.text-secondary; }

        // Where downloads land. Shown first because it is what people look for.
        Rectangle { height: 96px; border-width: 1px; border-color: Colors.border; border-radius: 12px; background: Colors.surface;
            VerticalLayout { padding: 14px; spacing: 10px;
                HorizontalLayout { spacing: 8px; alignment: start;
                    Text { text: "Lo que recibas se guarda en"; font-size: 12px; color: Colors.text-secondary; vertical-alignment: center; }
                    Text { text: Data.receive-dir; font-size: 12px; font-weight: 600; color: Colors.accent; overflow: elide; vertical-alignment: center; }
                }
                HorizontalLayout { height: 34px; spacing: 8px;
                    TyuButton { label: "Descargas"; secondary: true; width: 118px; clicked => { Data.action("dest-downloads"); } }
                    TyuButton { label: "Documentos"; secondary: true; width: 126px; clicked => { Data.action("dest-documents"); } }
                    TyuButton { label: "Otra carpeta…"; secondary: true; width: 138px; clicked => { Data.action("dest-choose"); } }
                    TyuButton { label: "Abrir carpeta"; secondary: true; width: 132px; clicked => { Data.action("open-destination"); } }
                }
            }
        }

        HorizontalLayout { height: 42px; spacing: 12px;
            TyuButton {
                label: "Enviar archivos al teléfono";
                has-icon: true;
                icon: @image-url("../../../assets/icons/send.svg");
                width: 250px;
                enabled: Data.connected;
                clicked => { Data.action("add-files"); }
            }
            TyuButton { label: Data.transfer-paused ? "Reanudar" : "Pausar"; secondary: true; width: 120px; enabled: Data.connected && Data.transfer-running; clicked => { Data.action("transfer"); } }
            TyuButton { label: "Cancelar"; secondary: true; width: 120px; enabled: Data.transfer-running; clicked => { Data.action("cancel-transfer"); } }
            TyuButton { label: "Limpiar"; secondary: true; width: 110px; enabled: Data.files.length > 0; clicked => { Data.action("clear-transfers"); } }
        }
        if !Data.connected: Text { text: "Conecta un dispositivo para enviar archivos."; font-size: 13px; color: Colors.warning; }

        for file in Data.files: Rectangle { height: file.openable ? 106px : 78px; background: transparent;
            VerticalLayout { spacing: 8px;
                HorizontalLayout { spacing: 14px; height: 40px;
                    // Direction at a glance: down for something arriving, up for something leaving.
                    Text {
                        text: file.incoming ? "↓" : "↑";
                        font-size: 20px;
                        color: file.incoming ? Colors.accent : Colors.text-secondary;
                        vertical-alignment: center;
                        width: 18px;
                    }
                    VerticalLayout { spacing: 3px;
                        Text { text: file.name; font-size: 14px; color: Colors.text-primary; overflow: elide; }
                        Text { text: (file.incoming ? "Del teléfono" : "Al teléfono") + " · " + file.size; font-size: 11px; color: Colors.muted; }
                    }
                    Text { text: file.status; font-size: 12px; color: file.progress >= 1 ? Colors.success : Colors.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                }
                if file.progress < 1: TyuProgress { value: file.progress; }
                if file.openable: HorizontalLayout { height: 32px; spacing: 8px; alignment: start;
                    TyuButton { label: "Abrir"; secondary: true; width: 100px; clicked => { Data.action("open:" + file.id); } }
                    TyuButton { label: "Ver en carpeta"; secondary: true; width: 148px; clicked => { Data.action("reveal:" + file.id); } }
                }
            }
        }
        if Data.files.length == 0: Text { text: "Todavía no hay transferencias. Envía algo desde aquí, o compártelo desde el teléfono."; font-size: 14px; color: Colors.text-secondary; wrap: word-wrap; }
    }
}
