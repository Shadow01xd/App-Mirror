import { Colors } from "../theme/colors.slint";
import { Typography } from "../theme/typography.slint";
import { Spacing } from "../theme/spacing.slint";

export component SetupPhoneScreen inherits Rectangle {
    background: Colors.background;
    VerticalLayout {
        padding: Spacing.xl;
        spacing: Spacing.md;
        alignment: start;
        Text { text: "Set up your phone"; color: Colors.text-primary; font-family: Typography.ui-family; font-size: Typography.display-size; font-weight: 700; }
        Text { text: "Follow the connection steps on this computer and your phone."; color: Colors.text-secondary; font-family: Typography.ui-family; font-size: Typography.body-size; wrap: word-wrap; }
    }
}

